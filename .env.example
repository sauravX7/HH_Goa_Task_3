# Environment Variables for Face Provenance Pipeline

# Blockchain Network Selection (hardhat | anvil | polygon_amoy)
BLOCKCHAIN_NETWORK=hardhat
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Polygon Amoy Testnet (Optional for live testnet deployment)
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_AMOY_PRIVATE_KEY=

# Reverse Search Engine API Keys
SERPAPI_API_KEY=
BING_VISUAL_SEARCH_API_KEY=

# Pipeline & Match Threshold Settings
SIMILARITY_THRESHOLD=0.60
DISTANCE_THRESHOLD=0.60
FACE_DETECTOR_BACKEND=face_recognition

# Demo & Logging
DEMO_MODE=false
DEMO_STEP_DELAY=1.5
LOG_LEVEL=INFO
